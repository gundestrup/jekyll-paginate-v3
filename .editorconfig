root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Ruby sources follow upstream's tab-indented style (.rubocop.yml agrees).
[{*.rb,*.gemspec,Rakefile,Gemfile}]
indent_style = tab

[*.{yml,yaml,json,md}]
indent_style = space
indent_size = 2
