// markdownlint-cli2 configuration — used by CLI and vscode-markdownlint.
{
  "config": {
    "MD013": false,
    "MD033": false,
    "MD060": false,
    "MD024": { "siblings_only": true },
    "MD012": { "maximum": 3 },
    "MD041": false
  },
  "gitignore": true,
  "globs": [
    "AGENTS.md",
    "[Cc][Hh][Aa][Nn][Gg][Ee][Ll][Oo][Gg].md",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "DEVIN.md",
    "DOCUMENTATION.md",
    "[Rr][Ee][Aa][Dd][Mm][Ee].md",
    "README.Development.md",
    "README.developer.md",
    "README.performance.md",
    "README.devel*.md",
    "RELEASE.md",
    "SECURITY.md",
    "STYLING.md",
    "TESTING.md",
    "WINDSURF.md",
    ".devin/*.md",
    ".github/**/*.md"
  ],
  "ignores": [
    "**/node_modules/**",
    "vendor/**",
    "coverage/**",
    "_site/**",
    ".jekyll-cache/**",
    "tmp/**"
  ]
}
